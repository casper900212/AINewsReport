{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/sever.js",
  "private": true,
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npm run build && nodemon",
    "build": "rm -rf dist; tsoa spec-and-routes && tsc --project tsconfig-build.json",
    "build-route": "tsoa routes --basePath /api/v1",
    "build-swagger": "tsoa spec --basePath /api/v1",
    "eslint": "eslint -c .eslintrc \"./**/*.ts\"",
    "eslint:fix": "eslint --fix \"./src/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs -d src/utils/dbHelper.ts",
    "typeorm:drop": "npm run typeorm schema:drop",
    "typeorm:sync": "npm run typeorm schema:sync"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.30",
    "@types/swagger-ui-express": "^4.1.8",
    "ericlint": "^1.1.17",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.8.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "typeorm": "^0.3.24",
    "winston": "^3.17.0"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "legacyWatch": true,
    "ext": "ts",
    "exec": "npm run build-route && npm run build-swagger && ts-node --transpile-only src/server.ts",
    "ignore": [
      "src/routes"
    ]
  }
}
